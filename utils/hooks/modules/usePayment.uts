import { ref, computed, watch } from 'vue'
import { showToast } from './toast'

/**
 * 支付平台类型
 */
export type PaymentPlatform = 'wechat' | 'alipay'

/**
 * 平台类型
 */
export type PlatformType = 'app' | 'h5' | 'mp-weixin' | 'mp-alipay'

/**
 * 支付状态类型
 */
export type PayStatus = 'pending' | 'success' | 'failed'

/**
 * 支付配置参数
 */
export interface PaymentConfig {
  /** 订单号 */
  orderNo: string
  /** 订单金额 */
  amount?: number | string
  /** 支付平台（微信/支付宝） */
  platform?: PaymentPlatform
  /** 是否为课程支付 */
  isCourse?: boolean
  /** 微信openid（小程序、JSAPI支付需要） */
  wxOpenid?: string
  /** 微信Code（小程序、JSAPI支付需要） */
  wxCode?: string
  /** H5支付成功后跳转地址 */
  redirectUrl?: string
  /** 支付成功回调 */
  onSuccess?: (orderNo: string) => void
  /** 支付失败回调 */
  onFailed?: (orderNo: string, error?: any) => void
  /** 支付取消回调 */
  onCancel?: () => void
}

/**
 * 获取当前运行平台
 */
function getCurrentPlatform(): PlatformType {
  /* eslint-disable no-unreachable */
  // #ifdef APP-ANDROID || APP-IOS || APP
  return 'app'
  // #endif

  // #ifdef MP-WEIXIN
  return 'mp-weixin'
  // #endif

  // #ifdef MP-ALIPAY
  return 'mp-alipay'
  // #endif

  // #ifdef H5 || WEB
  return 'h5'
  // #endif

  return 'h5' // 默认返回h5
  /* eslint-enable no-unreachable */
}

/**
 * 获取支付类型参数
 * @param platform 支付平台
 * @param currentPlatform 当前运行平台
 * @returns paytype 参数
 */
function getPayType(platform: PaymentPlatform, currentPlatform: PlatformType): number {
  if (platform === 'wechat') {
    switch (currentPlatform) {
      case 'app':
        return 2 // APP支付
      case 'h5':
        return 1 // Native扫码支付（H5显示二维码）
      case 'mp-weixin':
        return 4 // 小程序支付
      default:
        return 0 // JSAPI支付
    }
  } else {
    // 支付宝支付类型
    return currentPlatform === 'h5' ? 1 : 2
  }
}

