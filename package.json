{
  "name": "tailwindcss-uniappx",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "pnpm run lint",
    "prepack": "pnpm run build",
    "lint": "pnpm exec eslint .",
    "lint:staged": "pnpm exec lint-staged --relative --concurrent false --max-arg-length 5000",
    "tailwind:build": "pnpm exec postcss ./tailwind.css -o ./static/tailwind.css",
    "tailwind:watch": "pnpm exec postcss ./tailwind.css -o ./static/tailwind.css --watch",
    "version": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "vue-eslint-parser": "^10.2.0",
    "weapp-tailwindcss": "^4.11.2"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "tang-ui-x": "^1.3.5"
  },
  "lint-staged": {
    "**/*.{uts,uvue,ts,js,cjs,mjs}": [
      "pnpm exec eslint"
    ]
  }
}
